# AEOS Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── API Keys ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=

# Google Vertex AI — set path to service account JSON, or use ADC
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Local / custom endpoints ──────────────────────────────────────────────────
# Add keys for any custom providers configured in config.yaml
VLLM_API_KEY=
LOCAL_ANTHROPIC_KEY=

# ── Docker: override project directory ───────────────────────────────────────
# Defaults to current directory (.) if not set
# PROJECT_DIR=/path/to/your/project
