# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing / CI
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage.xml

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# AEOS workspace (the output of AEOS runs — NOT the source)
.aeos/state.json
.aeos/state.backup.json
.aeos/logs/

# Secrets — never bake API keys into the image
.env
*.env
secrets.yaml
**/secrets/

# Large data
*.db
*.sqlite

# OS noise
.DS_Store
Thumbs.db
